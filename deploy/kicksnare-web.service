[Unit]
Description=Kicksnare (web)
After=network.target

[Service]
User=kicksnare
Group=kicksnare
WorkingDirectory=/opt/kicksnare
EnvironmentFile=/etc/kicksnare.env
ExecStart=/opt/kicksnare/.venv/bin/uvicorn kicksnare.asgi:application --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
