# Copie para /etc/kicksnare.env (chmod 600) e ajuste.
KICKSNARE_BASE=/kicksnare
KICKSNARE_DATA=/var/lib/kicksnare
# Conta do dono (admin: vê as músicas de todos). Criada na primeira subida; troque a senha em /account.
KICKSNARE_ADMIN_USER=seu.usuario
KICKSNARE_ADMIN_PASSWORD=troque-esta-senha
# Só se o yt-dlp da venv não funcionar (Python < 3.10): "/caminho/python -m yt_dlp"
#KICKSNARE_YTDLP=
# Separação da bateria. htdemucs_ft: mais limpo, ~4x mais lento que htdemucs. Ao trocar, as músicas
# reprocessadas refazem a separação.
#KICKSNARE_DEMUCS_MODEL=htdemucs
#KICKSNARE_DEMUCS_SHIFTS=1
# Identifica banda e nome da música pelo título do vídeo (Groq). Sem a chave, a etapa é pulada.
#KICKSNARE_GROQ_API_KEY=
#KICKSNARE_GROQ_MODEL=openai/gpt-oss-120b
